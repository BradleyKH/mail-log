    "lucide-react": "^1.61.0",
    "minisearch": "^7.2.0",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
